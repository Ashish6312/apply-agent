# --- LLM provider selection ---
# Which provider the agent uses. One of: groq, gemini
LLM_PROVIDER=groq

# Model name is never hardcoded in code - set it here.
# Groq: currently-available fast/free models, e.g. openai/gpt-oss-20b, openai/gpt-oss-120b
#       (check `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
#        for the live list - Groq deprecates/renames models over time)
# Gemini: e.g. gemini-3.6-flash (check https://ai.google.dev/gemini-api/docs/models
#       for the live list - Google retires model names over time, same as Groq)
MODEL_NAME=openai/gpt-oss-20b

# --- API keys (only the one matching LLM_PROVIDER is required) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional tuning ---
# Seconds to wait for an LLM call before treating it as a timeout/failure
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
