# Streamlit Cloud has no .env file - it reads secrets from here instead
# (Settings -> Secrets in the app dashboard, same TOML format, or a local
# .streamlit/secrets.toml for testing that against a real Cloud-style setup).
# frontend/streamlit_app.py copies these into os.environ on startup so
# app.core.config.Settings picks them up exactly like it does locally.
#
# Copy this file to .streamlit/secrets.toml and fill in real values -
# that file is gitignored, this example isn't.

LLM_PROVIDER = "gemini"
MODEL_NAME = "gemini-3.6-flash"
GROQ_API_KEY = ""
GEMINI_API_KEY = "your_key_here"
